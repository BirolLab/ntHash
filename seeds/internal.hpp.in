inline uint64_t
srol_table(unsigned char c, unsigned d)
{
  return (MS_TAB_31L[c][d < 31 ? d : d % 31] | /* NOLINT */
          MS_TAB_33R[c][d < 33 ? d : d % 33]); /* NOLINT */
}

